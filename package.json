{
  "name": "st-planning-master-data",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "npm run clean:stale && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean:delivery": "rm -rf node_modules .next tsconfig.tsbuildinfo vv.txt .env.local",
    "clean:stale": "node scripts/remove-stale-legacy.mjs",
    "i18n:check": "node scripts/check-ui-i18n.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "exceljs": "4.4.0",
    "next": "16.3.1",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
