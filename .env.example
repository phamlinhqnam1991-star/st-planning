# V438 canonical PostgreSQL runtime (Aiven or any standard PostgreSQL provider)
# Aiven URI example ends with ?sslmode=require
DATABASE_URL=postgresql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Aiven Free has max_connections=20 and no built-in connection pooler.
# Keep this at 1 for Vercel serverless unless you intentionally size it up later.
DB_POOL_MAX=1
DB_CONNECT_TIMEOUT_MS=20000

# Supabase Storage (optional legacy import only) is retained only for optional legacy Storage/import flows.
# Database reads/writes no longer use Supabase REST or SUPABASE_DB_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# V478 Aiven Auth bootstrap only: comma-separated first Admin email(s). After login, create normal ADMIN accounts in Users & Permissions.
ADMIN_EMAILS=
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_HOURS=12

# Dashboard AI · Primary = Groq, automatic fallback = OpenRouter (server-side only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ST Planning
AI_MAX_TOOL_ROUNDS=4
GROQ_AI_MAX_TOOL_ROUNDS=4

# Provider-neutral PostgreSQL backup/restore
DB_BACKUP_URL=
DB_RESTORE_URL=
PG_DUMP_PATH=
PG_RESTORE_PATH=
DB_BACKUP_DIR=backups

# V508 Global Realtime No-Supabase
# No realtime-specific environment variable is required.
# Cross-device sync uses Aiven PostgreSQL table system_change_event (migration 086)
# plus the app's /api/realtime/change-events feed. Supabase variables above are
# optional legacy Storage/import only and are not used by realtime.
