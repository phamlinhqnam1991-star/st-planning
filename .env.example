NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional: exact PostgreSQL URL override; skips automatic DNS/host probing.
DB_CONNECTION_STRING=
# Optional server-side tuning. Defaults: 5 local slots, 20000 ms connect timeout.
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=20000
ADMIN_EMAILS=
# Dashboard AI · Groq (server-side only; do not expose the API key to the browser)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
