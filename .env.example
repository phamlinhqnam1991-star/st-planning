NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional: exact PostgreSQL URL override; skips automatic DNS/host probing.
DB_CONNECTION_STRING=
# Optional server-side tuning. Defaults: 5 local slots, 20000 ms connect timeout.
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=20000
ADMIN_EMAILS=
# Dashboard AI · Primary = Groq, automatic fallback = OpenRouter (server-side only)
# Never expose provider API keys to the browser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Free fallback provider. Default model uses OpenRouter Free Models Router.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ST Planning

# Optional: maximum read-only database tool rounds per Ask AI request. Default 4, max 6.
AI_MAX_TOOL_ROUNDS=4
# Backward-compatible old setting; used only when AI_MAX_TOOL_ROUNDS is blank.
GROQ_AI_MAX_TOOL_ROUNDS=4
